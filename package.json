{
  "name": "qol",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "prettier": "fcore/prettier",
  "scripts": {
    "build": "npm run format && npm run lint && fcore-build",
    "build:all": "npm --prefix ../fcore run build && npm run build",
    "release": "fcore-release",
    "watch": "fcore-build --watch",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier --write --log-level warn \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@vladislavprimakov/fcore": "file:../fcore",
    "fcore": "file:../fcore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "^11.2.0",
    "prettier": "^3.5.0",
    "typed-factorio": "^4.2.0",
    "typescript": "6.0.2",
    "typescript-to-lua": "^1.37.0"
  }
}
